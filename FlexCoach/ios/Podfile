# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# React Native Firebase resolves the Firebase Apple SDK via Swift Package
# Manager, which requires dynamically linked frameworks.
use_frameworks! :linkage => :dynamic

target 'FlexCoach' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.0
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
        end
        # react-native-image-picker uses MobileCoreServices (UTType*) symbols
        # without declaring the framework. With dynamic frameworks every pod
        # links on its own, so add it explicitly.
        if target.name == 'react-native-image-picker'
          flags = config.build_settings['OTHER_LDFLAGS']
          flags = flags.is_a?(Array) ? flags : [flags || '$(inherited)']
          flags << '-framework' << 'MobileCoreServices'
          config.build_settings['OTHER_LDFLAGS'] = flags
        end
        # react-native-bottom-tabs imports Fabric headers with quotes
        # (#import "RCTConversions.h"), which dynamic frameworks don't expose
        # on the search path. Point it at React Native's Fabric sources.
        if target.name == 'react-native-bottom-tabs'
          paths = config.build_settings['HEADER_SEARCH_PATHS']
          paths = paths.is_a?(Array) ? paths : [paths || '$(inherited)']
          paths << '"$(PODS_ROOT)/../../node_modules/react-native/React/Fabric"'
          paths << '"$(PODS_ROOT)/../../node_modules/react-native/ReactCommon/react/renderer/imagemanager/platform/ios/react/renderer/imagemanager"'
          config.build_settings['HEADER_SEARCH_PATHS'] = paths
        end
      end
    end
  end
end
