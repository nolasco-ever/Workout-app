rules_version = '2';

// FlexCoach Firestore security rules.
//
// Every user's data lives under users/{uid}. Only that user can read or write
// it. Buddies can read one document, publicProfiles/{uid}, and only when an
// accepted buddy relationship exists on the owner's side. Nothing else is
// readable across accounts.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAcceptedBuddyOf(uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid)/buddies/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(uid)/buddies/$(request.auth.uid)).data.status == 'accepted';
    }

    // Private user tree: profile plus every subcollection.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Plans the owner marked visible can be read (and so copied) by
      // accepted buddies. A buddy's list query must filter on the flag.
      match /plans/{planId} {
        allow read: if isOwner(uid) || (isAcceptedBuddyOf(uid) && resource.data.visibleToBuddies == true);
        allow write: if isOwner(uid);
      }
      match /cycles/{cycleId} {
        allow read, write: if isOwner(uid);
      }
      match /sessions/{sessionId} {
        allow read, write: if isOwner(uid);
      }
      match /bodyWeight/{entryId} {
        allow read, write: if isOwner(uid);
      }
      match /achievements/{achievementId} {
        allow read, write: if isOwner(uid);
      }
      match /customExercises/{exerciseId} {
        allow read, write: if isOwner(uid);
      }
      // In-app notification feed. The owner reads, marks read and deletes;
      // the device also creates its own items (missed workout, cycle done).
      // Buddies may create the few kinds addressed to this user: a request
      // once their pending row exists, and the rest once accepted. Only
      // create, never overwrite, so a buddy can't rewrite what's there.
      match /notifications/{notificationId} {
        allow read, write: if isOwner(uid);
        allow create: if signedIn() && request.auth.uid != uid
          && request.resource.data.ownerId == uid
          && (
            (request.resource.data.kind == 'buddy_request'
              && exists(/databases/$(database)/documents/users/$(uid)/buddies/$(request.auth.uid)))
            || (request.resource.data.kind in ['buddy_accepted', 'buddy_streak', 'buddy_achievement']
              && isAcceptedBuddyOf(uid))
          );
      }
      // What the owner has been up to, in buddy-safe words. Buddies read it
      // and merge everyone's into one feed.
      match /activity/{activityId} {
        allow read: if isOwner(uid) || isAcceptedBuddyOf(uid);
        allow write: if isOwner(uid);
      }
      // Push tokens, one per install. Only the owner and the server touch them.
      match /devices/{token} {
        allow read, write: if isOwner(uid);
      }

      // Buddy relationships are mirrored on both sides. The owner manages
      // their own list; another signed-in user may only create a pending
      // request or accept/remove the row about themselves.
      match /buddies/{otherUid} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid);
        allow create: if signedIn() && request.auth.uid == otherUid
          && request.resource.data.status in ['pending_received', 'pending_sent'];
        allow update: if signedIn() && request.auth.uid == otherUid
          && request.resource.data.status == 'accepted';
        allow delete: if signedIn() && request.auth.uid == otherUid;
      }
    }

    // Buddy-visible summary (the Iron Card). Owner writes; accepted buddies read.
    match /publicProfiles/{uid} {
      allow read: if isOwner(uid) || isAcceptedBuddyOf(uid);
      allow write: if isOwner(uid);
    }

    // A scanned or typed card code resolves here. Anyone signed in with the
    // code can read the card copy; only its owner writes it.
    match /inviteCodes/{code} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Deny anything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
